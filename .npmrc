# 桌面端 / 测试专员机器常见环境问题的规避：
#  1. Windows Defender 实时扫描 vs pnpm 虚拟 store = -4094 UNKNOWN 错误
#  2. Windows MAX_PATH 260 限制 = 深嵌套 .pnpm 目录写失败
# hoisted 把 node_modules 拍平，和旧式 npm 一样，换短路径 + 少 FS 操作。
node-linker=hoisted

# 拷贝而非硬链接：Windows 上某些 AV 会把硬链接当可疑操作误报
package-import-method=copy

# 自动同意 Playwright / esbuild 等的 postinstall；测试机可信环境
auto-install-peers=true
strict-peer-dependencies=false
