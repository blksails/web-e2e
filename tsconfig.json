{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "@playwright/test"],
    "baseUrl": ".",
    "paths": {
      "@e2e/*": ["./*"]
    }
  },
  "include": [
    "playwright.config.ts",
    "global-setup.ts",
    "fixtures/**/*.ts",
    "pages/**/*.ts",
    "reporters/**/*.ts",
    "scripts/**/*.ts",
    "scripts/__tests__/**/*.ts",
    "tests/**/*.ts"
  ]
}
