# Copy to .env.local and fill in real values. Never commit secrets.

# Target environment. The E2E suite is locked to company_id=1 on staging unless overridden.
E2E_BASE_URL=https://web-beta.apps.blksails.cn
E2E_ENV=staging

# Guardrail: tests assert this matches the authed tenant before any destructive action.
E2E_EXPECTED_COMPANY_ID=1

# Admin account for storageState. Must belong to company_id=1.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Optional second user for invite / multi-member flows.
E2E_MEMBER_EMAIL=
E2E_MEMBER_PASSWORD=

# Playwright
PWDEBUG=0
CI=0
